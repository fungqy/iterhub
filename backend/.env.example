# ========================================
# 数据库配置（完整 SQLAlchemy URL）
# - host 写 127.0.0.1 别写 localhost:数据库在 WSL 时,localhost 会先试 IPv6 ::1,
#   超时 10 秒才回退 IPv4,每次新建连接都白等 10 秒
# ========================================
MSQL_DSN=mysql+pymysql://iteruser:iterpass123@127.0.0.1:3306/iterdb

# ========================================
# 服务配置
# ========================================
HOST=0.0.0.0
PORT=8000

# ========================================
# 企微推送开关
# - true  (或 1/yes): 真实推送到企微群
# - false (或 0/no) : 仅记录日志，不推送（开发环境使用，避免打扰企微群）
# ========================================
PUSH_ENABLED=false

# ========================================
# JWT 签名密钥
# - 不设置：启动时自动生成随机 key（仅供开发，重启后旧 token 失效）
# - 设置占位符 your-secret-key-change-in-production：拒绝启动
# - 生产环境必须设置一个 ≥32 字节的随机串
# ========================================
# JWT_SECRET_KEY=please-replace-with-a-long-random-string-at-least-32-chars

# ========================================
# Confluence / Wiki 凭据（report_wiki_data 任务）
# - 缺失任意一项：相关任务模块拒绝运行（不静默放行）
# ========================================
WIKI_URL=http://wiki.zvos.zoomlion.com
WIKI_USERNAME=your_wiki_account
WIKI_PASSWORD=your_wiki_password

# ========================================
# GitLab / SonarQube 凭据（remind_sonar_scan 任务）
# - 缺失任意一项：相关任务模块拒绝运行（不静默放行）
# ========================================
GITLAB_URL=http://gitlab.zoomlion.com
GITLAB_TOKEN=your_gitlab_private_token
GITLAB_USERNAME=your_gitlab_username
SONAR_URL=http://sonar.zvos.zoomlion.com
SONAR_TOKEN=your_sonar_token
